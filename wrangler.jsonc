{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ffpf-certifications",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// FFPF_ID_CLIENT_SECRETとFFPF_SESSION_SECRETはシークレットとして設定する（README参照）。
	"vars": {
		"FFPF_ID_ISSUER": "https://ffpf-portal.vercel.app",
		"FFPF_ID_CLIENT_ID": "ffpf-certifications"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ffpf-certifications-db",
			"database_id": "29f15e16-fdda-48d4-a1f2-826314853aa6",
			"migrations_dir": "./migrations"
		}
	]
}
